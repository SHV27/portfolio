---
/**
 * THE COSMOS — the feeling of travelling, not the picture of it.
 *
 * Three star layers at three apparent distances. As you scroll, the near layer
 * slides fastest, the mid layer slower, the far layer barely at all — which is
 * exactly how real depth reads to the eye. That differential IS the sensation of
 * moving through a volume of stars; a single background image can never produce
 * it no matter how good the image is.
 *
 * Entirely generated: layered radial-gradients. Zero network bytes, zero licence
 * risk, and it stays razor sharp at any zoom — where a compressed starfield JPEG
 * smears its faint stars into grey mush.
 *
 * Cost: three fixed elements, transformed on the compositor. No canvas, no
 * WebGL, no shader compile, no battery drain on a mid-range phone.
 */
---

<div class="cos" aria-hidden="true">
  <div class="cos__l cos__l--far"  data-depth="0.06"></div>
  <div class="cos__l cos__l--mid"  data-depth="0.16"></div>
  <div class="cos__l cos__l--near" data-depth="0.34"></div>
  <div class="cos__glow"></div>
</div>

<style>
  .cos { position: fixed; inset: 0; z-index: -2; pointer-events: none; background: var(--void); }

  .cos__l {
    position: absolute;
    inset: -30% -10%;
    will-change: transform;
    background-repeat: repeat;
  }

  /* FAR — dense, tiny, dim. The static backdrop of the galaxy. */
  .cos__l--far {
    background-image:
      radial-gradient(0.6px 0.6px at 15% 12%, rgb(245 242 234 / 0.5), transparent),
      radial-gradient(0.6px 0.6px at 62% 27%, rgb(245 242 234 / 0.42), transparent),
      radial-gradient(0.5px 0.5px at 38% 71%, rgb(245 242 234 / 0.38), transparent),
      radial-gradient(0.6px 0.6px at 84% 58%, rgb(245 242 234 / 0.45), transparent),
      radial-gradient(0.5px 0.5px at 27% 44%, rgb(200 214 245 / 0.34), transparent),
      radial-gradient(0.6px 0.6px at 73% 88%, rgb(245 242 234 / 0.4), transparent),
      radial-gradient(0.5px 0.5px at 8% 82%, rgb(245 242 234 / 0.3), transparent),
      radial-gradient(0.6px 0.6px at 94% 19%, rgb(245 242 234 / 0.36), transparent);
    background-size: 240px 240px, 300px 300px, 210px 210px, 340px 340px,
                     270px 270px, 190px 190px, 320px 320px, 260px 260px;
  }

  /* MID — the working layer. A few carry colour: young stars run blue-white,
     older ones amber. Real star fields are not monochrome. */
  .cos__l--mid {
    background-image:
      radial-gradient(1px 1px at 22% 18%, rgb(245 242 234 / 0.75), transparent),
      radial-gradient(1px 1px at 68% 52%, rgb(200 214 245 / 0.62), transparent),
      radial-gradient(1.2px 1.2px at 45% 81%, rgb(245 242 234 / 0.7), transparent),
      radial-gradient(1px 1px at 88% 33%, rgb(230 169 78 / 0.5), transparent),
      radial-gradient(1px 1px at 12% 64%, rgb(245 242 234 / 0.6), transparent),
      radial-gradient(1.2px 1.2px at 57% 8%, rgb(245 242 234 / 0.55), transparent);
    background-size: 480px 480px, 560px 560px, 420px 420px,
                     640px 640px, 520px 520px, 600px 600px;
  }

  /* NEAR — few, bright, with a faint bloom. These are the ones you feel move. */
  .cos__l--near {
    background-image:
      radial-gradient(1.8px 1.8px at 18% 26%, rgb(245 242 234 / 0.95), rgb(245 242 234 / 0.12) 40%, transparent 70%),
      radial-gradient(2px 2px at 76% 68%, rgb(255 236 200 / 0.9), rgb(230 169 78 / 0.14) 40%, transparent 70%),
      radial-gradient(1.6px 1.6px at 52% 14%, rgb(210 226 255 / 0.85), rgb(200 214 245 / 0.12) 40%, transparent 70%),
      radial-gradient(1.8px 1.8px at 34% 88%, rgb(245 242 234 / 0.8), transparent 65%);
    background-size: 900px 900px, 1100px 1100px, 980px 980px, 1240px 1240px;
  }

  /* The far glow of a galactic core. Deliberately almost invisible — visible
     coloured fog is the single most reliable tell of a fake cosmic site. */
  .cos__glow {
    position: absolute; inset: 0;
    background:
      radial-gradient(70% 50% at 84% 6%, rgb(200 90 60 / 0.09), transparent 68%),
      radial-gradient(60% 45% at 8% 88%, rgb(110 132 186 / 0.07), transparent 68%),
      radial-gradient(90% 60% at 50% 50%, transparent 55%, rgb(8 8 11 / 0.5) 100%);
  }

  /* At rest the field breathes, very slowly, so the page is never quite static —
     the way a long-exposure sky is never quite static. 90 seconds per cycle. */
  @media (prefers-reduced-motion: no-preference) {
    .cos__l--far  { animation: drift-a 180s linear infinite; }
    .cos__l--mid  { animation: drift-b 120s linear infinite; }
    .cos__l--near { animation: drift-c 90s linear infinite; }
    @keyframes drift-a { to { background-position: 240px 120px, 300px 150px, 210px 105px, 340px 170px, 270px 135px, 190px 95px, 320px 160px, 260px 130px; } }
    @keyframes drift-b { to { background-position: -480px 240px, -560px 280px, -420px 210px, -640px 320px, -520px 260px, -600px 300px; } }
    @keyframes drift-c { to { background-position: 900px -450px, 1100px -550px, 980px -490px, 1240px -620px; } }
  }
</style>

<script>
  /* Scroll-differential parallax: the whole point. Each layer translates by
     scrollY × its own depth, so near stars sweep past while far ones hold —
     which is what reading as "travel" actually requires.
     Transform-only, compositor-driven, rAF-throttled. Never touches layout. */
  const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
  if (motionOK) {
    const layers = Array.from(document.querySelectorAll<HTMLElement>('.cos__l')).map((el) => ({
      el,
      depth: parseFloat(el.dataset.depth || '0'),
    }));
    let ticking = false;
    const run = () => {
      ticking = false;
      const y = window.scrollY;
      for (const { el, depth } of layers) {
        el.style.transform = `translate3d(0, ${-y * depth}px, 0)`;
      }
    };
    window.addEventListener(
      'scroll',
      () => { if (!ticking) { ticking = true; requestAnimationFrame(run); } },
      { passive: true },
    );
    run();
  }
</script>
