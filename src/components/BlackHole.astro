---
/**
 * GARGANTUA — a black hole you can pick up and move.
 *
 * Drag it (or move your pointer, or drag with a finger) and the stars behind it
 * bend around it. The deflection is the real thing, not a blur filter: light
 * passing a mass is deflected by an angle proportional to 1/r, so each star's
 * apparent position is pushed away from the hole along the radial direction,
 * and stars passing close get smeared into the arc of an Einstein ring. That is
 * why the ring appears on its own rather than being drawn — it falls out of the
 * maths, the same way it does in the sky.
 *
 * 2D canvas, ~500 stars, simple arithmetic per star per frame. No WebGL, no
 * shader compile, no texture upload — so it runs at 60fps on a mid-range phone
 * where a raymarched version would cook the battery and drop frames.
 *
 * Pauses entirely when scrolled out of view. Renders one static frame and stops
 * under prefers-reduced-motion.
 */
interface Props { height?: number; }
const { height = 620 } = Astro.props;
---

<section class="bh section" aria-labelledby="bh-h">
  <div class="wrap bh__head">
    <p class="label bh__k">Go on — grab it</p>
    <h2 id="bh-h" class="display display--mid bh__t">Move the black hole.</h2>
    <p class="bh__p">
      Watch the stars behind it bend. That curve is not an effect laid over the picture — each star's apparent
      position is being displaced by the same inverse-distance law that makes real starlight bend around real
      mass. Get close enough and the light wraps into a ring.
    </p>
  </div>

  <figure class="bh__stage" style={`--bh-h:${height}px`}>
    <canvas
      class="bh__canvas"
      data-blackhole
      role="img"
      aria-label="An interactive black hole. Stars behind it are bent around its edge into a bright ring. Drag it to move it."
    ></canvas>
    <figcaption class="bh__hint mono" data-bh-hint>drag &middot; or just move your pointer</figcaption>
  </figure>
</section>

<style>
  .bh { padding-block: clamp(var(--s-16), 9vh, var(--s-32)); }
  .bh__head { max-width: 58ch; }
  .bh__k { color: var(--gold); }
  .bh__t { font-size: var(--t-title); margin-top: var(--s-6); }
  .bh__p { margin-top: var(--s-6); color: var(--star-dim); }

  .bh__stage {
    position: relative;
    margin: var(--s-12) auto 0;
    width: min(100% - (var(--gutter) * 2), var(--page-max));
    height: var(--bh-h);
    border-radius: var(--r-lg);
    overflow: hidden;
    outline: var(--hair) solid var(--ridge);
    outline-offset: -1px;
    background: #040406;
    cursor: grab;
    touch-action: pan-y;
  }
  .bh__stage:active { cursor: grabbing; }
  .bh__canvas { display: block; width: 100%; height: 100%; }

  .bh__hint {
    position: absolute; left: 50%; bottom: var(--s-6); transform: translateX(-50%);
    font-size: var(--t-micro); letter-spacing: 0.14em; text-transform: uppercase;
    color: rgb(245 242 234 / 0.42);
    pointer-events: none;
    transition: opacity var(--d-slow) var(--ease);
  }
  .bh__hint[data-hidden] { opacity: 0; }

  @media (max-width: 640px) { .bh__stage { height: 420px; } }
</style>

<script>
  const cv = document.querySelector<HTMLCanvasElement>('[data-blackhole]');
  const hint = document.querySelector<HTMLElement>('[data-bh-hint]');

  if (cv) {
    const ctx = cv.getContext('2d', { alpha: false })!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    type Star = { x: number; y: number; r: number; a: number; hue: string; tw: number };
    let stars: Star[] = [];
    let W = 0, H = 0, DPR = 1;
    let hx = 0, hy = 0;          // hole position
    let tx = 0, ty = 0;          // target position
    let dragging = false;
    let t = 0;
    let raf = 0;
    let visible = false;

    const HUES = ['#F5F2EA', '#F5F2EA', '#F5F2EA', '#CFE0FF', '#FFE2B8', '#FFD0A8'];

    function size() {
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      const r = cv.getBoundingClientRect();
      W = r.width; H = r.height;
      cv.width = Math.round(W * DPR);
      cv.height = Math.round(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      seed();
      if (!hx) { hx = tx = W * 0.5; hy = ty = H * 0.5; }
    }

    function seed() {
      // Density scales with area so a wide screen is not sparse.
      const n = Math.round(Math.min(1100, Math.max(420, (W * H) / 850)));
      stars = Array.from({ length: n }, () => ({
        x: Math.random() * W,
        y: Math.random() * H,
        r: Math.random() * 1.15 + 0.25,
        a: Math.random() * 0.55 + 0.25,
        hue: HUES[(Math.random() * HUES.length) | 0],
        tw: Math.random() * Math.PI * 2,
      }));
    }

    /** Schwarzschild-ish radius in pixels. */
    const RS = () => Math.min(W, H) * 0.085;

    function frame() {
      raf = 0;
      t += 0.016;

      // Ease the hole toward its target — weight, not snap.
      hx += (tx - hx) * 0.085;
      hy += (ty - hy) * 0.085;

      const rs = RS();
      const disk = rs * 2.6;

      ctx.fillStyle = '#040406';
      ctx.fillRect(0, 0, W, H);

      // ---- STARS, LENSED ----------------------------------------------------
      for (const s of stars) {
        const dx = s.x - hx;
        const dy = s.y - hy;
        const d = Math.hypot(dx, dy) || 0.001;

        // Deflection falls off as 1/r. Light passing closer is bent more, so a
        // star's apparent position is pushed outward from the hole.
        const bend = (rs * rs * 1.9) / d;
        let ax = s.x + (dx / d) * bend;
        let ay = s.y + (dy / d) * bend;

        // Inside the shadow there is nothing to see.
        if (d < rs * 0.96) continue;

        // Close passes brighten and stretch tangentially — the Einstein ring.
        const near = Math.max(0, 1 - Math.abs(d - rs * 1.32) / (rs * 1.15));
        const alpha = Math.min(1, s.a * (1 + near * 3.4)) * (0.78 + 0.22 * Math.sin(t * 1.6 + s.tw));

        ctx.globalAlpha = alpha;
        ctx.fillStyle = s.hue;

        if (near > 0.08) {
          // Smear along the tangent: an arc, not a dot.
          const tanx = -dy / d, tany = dx / d;
          const len = near * near * rs * 0.9;
          ctx.lineWidth = s.r * (1 + near * 1.6);
          ctx.strokeStyle = s.hue;
          ctx.lineCap = 'round';
          ctx.beginPath();
          ctx.moveTo(ax - tanx * len, ay - tany * len);
          ctx.lineTo(ax + tanx * len, ay + tany * len);
          ctx.stroke();
        } else {
          ctx.beginPath();
          ctx.arc(ax, ay, s.r, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;

      // ---- ACCRETION DISK ---------------------------------------------------
      // Seen nearly edge-on, and brighter on the side rotating toward us —
      // relativistic beaming, the asymmetry Interstellar made famous.
      const beam = 0.5 + 0.5 * Math.sin(t * 0.5);
      const g = ctx.createRadialGradient(hx, hy, rs * 0.95, hx, hy, disk);
      g.addColorStop(0, 'rgba(255,214,150,0)');
      g.addColorStop(0.18, `rgba(255,208,145,${0.72 + beam * 0.2})`);
      g.addColorStop(0.42, 'rgba(235,155,72,0.46)');
      g.addColorStop(0.72, 'rgba(186,94,52,0.20)');
      g.addColorStop(1, 'rgba(120,60,40,0)');
      ctx.save();
      ctx.translate(hx, hy);
      ctx.rotate(-0.22);
      ctx.scale(1, 0.26);                       // edge-on
      ctx.translate(-hx, -hy);
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(hx, hy, disk, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      // ---- PHOTON RING ------------------------------------------------------
      const ring = ctx.createRadialGradient(hx, hy, rs * 0.99, hx, hy, rs * 1.5);
      ring.addColorStop(0, 'rgba(255,236,200,0.85)');
      ring.addColorStop(0.35, 'rgba(255,200,130,0.28)');
      ring.addColorStop(1, 'rgba(255,180,110,0)');
      ctx.fillStyle = ring;
      ctx.beginPath();
      ctx.arc(hx, hy, rs * 1.5, 0, Math.PI * 2);
      ctx.fill();

      // ---- THE SHADOW -------------------------------------------------------
      ctx.fillStyle = '#000';
      ctx.beginPath();
      ctx.arc(hx, hy, rs * 0.96, 0, Math.PI * 2);
      ctx.fill();

      if (visible && !reduce) raf = requestAnimationFrame(frame);
    }

    const kick = () => { if (!raf && visible && !reduce) raf = requestAnimationFrame(frame); };

    // ---- INPUT --------------------------------------------------------------
    const setTarget = (clientX: number, clientY: number) => {
      const r = cv.getBoundingClientRect();
      tx = Math.max(0, Math.min(W, clientX - r.left));
      ty = Math.max(0, Math.min(H, clientY - r.top));
      if (hint && !hint.hasAttribute('data-hidden')) hint.setAttribute('data-hidden', '');
      kick();
    };

    cv.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch' && !dragging) return;   // let the page scroll
      setTarget(e.clientX, e.clientY);
    }, { passive: true });

    cv.addEventListener('pointerdown', (e) => {
      dragging = true;
      cv.setPointerCapture(e.pointerId);
      setTarget(e.clientX, e.clientY);
    });
    cv.addEventListener('pointerup', (e) => {
      dragging = false;
      try { cv.releasePointerCapture(e.pointerId); } catch {}
    });

    // Keyboard: the hole is reachable without a pointer.
    cv.tabIndex = 0;
    cv.addEventListener('keydown', (e) => {
      const step = 28;
      const k = e.key;
      if (k === 'ArrowLeft') tx -= step;
      else if (k === 'ArrowRight') tx += step;
      else if (k === 'ArrowUp') ty -= step;
      else if (k === 'ArrowDown') ty += step;
      else return;
      e.preventDefault();
      tx = Math.max(0, Math.min(W, tx));
      ty = Math.max(0, Math.min(H, ty));
      if (hint) hint.setAttribute('data-hidden', '');
      kick();
    });

    // ---- LIFECYCLE ----------------------------------------------------------
    // Off-screen costs nothing at all.
    const io = new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible) kick();
      else if (raf) { cancelAnimationFrame(raf); raf = 0; }
    }, { rootMargin: '120px' });
    io.observe(cv);

    let rt: number | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => { size(); kick(); frame(); }, 160);
    }, { passive: true });

    size();
    frame();   // one static frame regardless, so reduced-motion still sees it
  }
</script>
