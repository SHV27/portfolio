---
/**
 * HOME — short on purpose.
 *
 * Hero → anthem → the claim → a nebula → the seven builds → two things you can
 * play with → who I am → contact. Everything dense lives on its own page:
 * /projects/<slug>, /projects/data-signal, /how-i-work.
 *
 * Rhythm rule from docs/ART-DIRECTION.md: reading → full-bleed → reading →
 * interactive → reading. Never two full-bleed moments in a row.
 */
import Base from '../layouts/Base.astro';
import TitleCard from '../sections/TitleCard.astro';
import Anthem from '../sections/Anthem.astro';
import Thesis from '../sections/Thesis.astro';
import StarBirth from '../sections/StarBirth.astro';
import WorkIndex from '../sections/WorkIndex.astro';
import Human from '../sections/Human.astro';
import Closing from '../sections/Closing.astro';
import Aside from '../components/Aside.astro';

import srkIconic from '../assets/aura/01-srk-iconic.jpg';
import starkVillains from '../assets/aura/02-stark-villains.jpg';
import bridgeBw from '../assets/photos/02-bridge-bw.jpg';
import rho from '../assets/space/rho-ophiuchi.jpg';
import pillars from '../assets/space/pillars.jpg';
---
<Base
  title="Shaurya Verma — I build AI systems that can't lie"
  description="Agentic-AI engineer, final year at Thapar. Five systems running in production, and every number on this site opens to the code behind it. Open for internship from January 2027."
>
  <TitleCard />

  <Anthem />

  <Thesis />

  <StarBirth
    plate={rho}
    credit="Rho Ophiuchi cloud complex · NASA, ESA, CSA, STScI, K. Pontoppidan (STScI), A. Pagan (STScI) · CC BY 4.0"
    kicker="Rho Ophiuchi — 390 light years away"
    line="The closest place to Earth where stars are being born."
    sub="Those red streaks are jets, fired by stars that switched on within the last few hundred thousand years. It is a photograph, not an illustration — which is roughly the standard I hold the rest of this site to."
    focus="52% 42%"
    height="tall"
  />

  <WorkIndex />

  <section class="section">
    <div class="wrap">
      <Aside src={starkVillains} side="right"
        alt="Robert Downey Jr. sitting on a film set holding a phone, overlaid with the words: I'm just like him, I create my own villains (problems) then kill (solve) them."
        caption="An uncomfortably accurate description of how I pick what to work on.">
        <p class="label hiw__k">Before you go further</p>
        <h2 class="hiw__t display">The speed isn't mine. The judgement is.</h2>
        <p class="hiw__p">
          I build with Claude Code and I am not going to be coy about it — everyone reading this has the same
          model. What separates the results is everything around it: a constitution written before the first
          file, an append-only log of every decision and why, and agents I point at my own work specifically to
          break it. That is a chapter of its own, and it comes with the files, so you can check rather than
          believe me.
        </p>
        <a class="hiw__cta" href="/how-i-work">
          Read how I actually work
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11 L11 3 M5 3 h6 v6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
      </Aside>
    </div>
  </section>

  <StarBirth
    plate={pillars}
    credit="The Pillars of Creation, Eagle Nebula · NASA, ESA and the Hubble Heritage Team (STScI/AURA) · CC BY 4.0"
    kicker="The Pillars of Creation"
    line="Columns of gas, light-years tall, collapsing into new stars."
    sub="Hubble, 2015. The pillars are being eroded by the very stars they are giving birth to."
    focus="50% 38%"
    height="mid"
  />

  <section class="section">
    <div class="wrap">
      <Aside src={bridgeBw} side="left"
        alt="Shaurya Verma in sunglasses on a riverside walkway, one hand pushed back through his hair, photographed in high-contrast black and white against a blown-out sky."
        caption="Patiala, somewhere near the water.">
        <p class="pull display">
          I am not asking you to take my word for a single thing on this page.
        </p>
        <p>
          Every number has a link under it that opens the file it came from. That is not modesty — it is the
          flex. Anyone can write a portfolio. Very few can hand you the receipts and invite you to go looking
          for the hole.
        </p>
      </Aside>
    </div>
  </section>

  <Human />

  <Closing />
</Base>

<style>
  .hiw__k { color: var(--gold); }
  .hiw__t { font-size: var(--t-head); margin-top: var(--s-4); }
  .hiw__p { margin-top: var(--s-6); color: var(--star-dim); }
  .pull {
    font-size: clamp(1.4rem, 2.8vw, 2.1rem);
    line-height: 1.18;
    color: var(--star);
    text-wrap: balance;
    margin-bottom: var(--s-6);
  }
  .hiw__cta {
    margin-top: var(--s-8);
    display: inline-flex; align-items: center; gap: var(--s-3);
    padding: 13px 26px; min-height: 48px;
    border: var(--hair) solid var(--gold);
    border-radius: var(--r-full);
    background: color-mix(in oklab, var(--gold) 7%, transparent);
    color: var(--gold); font-size: var(--t-small); text-decoration: none;
    transition: background var(--d-base) var(--ease);
  }
  .hiw__cta:hover { background: color-mix(in oklab, var(--gold) 16%, transparent); }
  .hiw__cta svg { transition: transform var(--d-base) var(--ease); }
  .hiw__cta:hover svg { transform: translate(2px, -2px); }
</style>
