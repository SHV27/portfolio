---
/**
 * A full project case study.
 *
 * Structure is fixed on purpose, so a reader learns it once and can then skim
 * seven of them: what it is → why it is hard → how it actually works (receipted)
 * → the numbers (receipted) → what he refused to do → the honest limits.
 *
 * The "restraint" and "limits" blocks are the ones that matter most. Anyone can
 * list features; almost nobody publishes what their system cannot do.
 */
import { Image } from 'astro:assets';
import Claim from '../components/Claim.astro';
import Figure from '../components/Figure.astro';
import type { Project } from '../content/types';
import { repoUrl } from '../content/types';
import { STORIES } from '../content/stories';

interface Props { project: Project; index: string; shots: Record<string, any>; }
const { project: p, index, shots } = Astro.props;
const story = STORIES[p.id];
---

<article class="pc section" id={p.id} data-accent={p.accent ?? 'gold'}>
  <div class="wrap">

    <header class="pc__head reveal">
      <p class="label pc__i">{index}</p>
      <h2 class="pc__name display">
        {p.name}{p.native && <span class="pc__native deva">{p.native}</span>}
      </h2>
      {p.tagline && <p class="pc__tag">{p.tagline}</p>}
      <p class="pc__hook">{p.dek ?? p.hook}</p>

      <div class="pc__meta">
        <span class="mono pc__year">{p.year}</span>
        {!['uruthi','jarvis','reckoner'].includes(p.repo) ? (
          <a class="pc__btn" href={repoUrl(p.repo)} target="_blank" rel="noopener noreferrer">
            Read the code
            <svg width="11" height="11" viewBox="0 0 11 11" aria-hidden="true"><path d="M2.5 8.5 L8.5 2.5 M4 2.5 h4.5 v4.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square"/></svg>
          </a>
        ) : (
          <span class="pc__btn pc__btn--muted">Source is private</span>
        )}
        {p.live && (
          <a class="pc__btn pc__btn--live" href={p.live} target="_blank" rel="noopener noreferrer">
            Open it — it's running
            <svg width="11" height="11" viewBox="0 0 11 11" aria-hidden="true"><path d="M2.5 8.5 L8.5 2.5 M4 2.5 h4.5 v4.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square"/></svg>
          </a>
        )}
      </div>
    </header>

    {p.shots[0] && shots[p.shots[0].file] && (() => {
      const m = shots[p.shots[0].file];
      const ar = m.width / m.height;
      const long = ar < 0.95;
      return (
        <figure class:list={['pc__hero', 'reveal', long && 'pc__fig--long']}>
          <div class="pc__heroframe" style={`--ar:${ar.toFixed(4)}`} tabindex={long ? 0 : undefined}>
            <Image src={m} alt={p.shots[0].alt} widths={[640, 980, 1320]} sizes="(max-width:900px) 92vw, 900px" loading="lazy" decoding="async" format="avif" />
          </div>
          <figcaption class="pc__cap">
            {p.shots[0].caption}
            {long && <span class="pc__scrollhint mono"> Scroll inside the frame for the rest of the page.</span>}
          </figcaption>
        </figure>
      );
    })()}

    {story && (
      <section class="pc__block pc__story reveal">
        {story.map((para) => <p class="pc__storyp" set:html={para} />)}
      </section>
    )}

    <section class="pc__block reveal">
      <h3 class="pc__h3">Why it was hard</h3>
      <p class="pc__prose">{p.hardProblem}</p>
    </section>

    <section class="pc__block reveal">
      <h3 class="pc__h3">How it actually works</h3>
      <ul class="pc__mech">
        {p.mechanism.map((c) => <Claim claim={c} />)}
      </ul>
    </section>

    {p.shots.length > 1 && (
      <div class="pc__shots">
        {p.shots.slice(1).map((s) => {
          const m = shots[s.file];
          if (!m) return null;
          const ar = m.width / m.height;
          const long = ar < 0.95;
          return (
            <figure class:list={['pc__shot', 'reveal', long && 'pc__fig--long']}>
              <div class="pc__shotframe" style={`--ar:${ar.toFixed(4)}`} tabindex={long ? 0 : undefined}>
                <Image src={m} alt={s.alt} widths={[520, 820]} sizes="(max-width:900px) 92vw, 720px" loading="lazy" decoding="async" format="avif" />
              </div>
              <figcaption class="pc__cap">
                {s.caption}
                {long && <span class="pc__scrollhint mono"> Scroll inside the frame.</span>}
              </figcaption>
            </figure>
          );
        })}
      </div>
    )}

    <section class="pc__block reveal">
      <h3 class="pc__h3">The numbers</h3>
      <div class="pc__figs">
        {p.figures.map((f) => <Figure figure={f} />)}
      </div>
    </section>

    {p.restraint && (
      <section class="pc__block pc__restraint reveal">
        <h3 class="pc__h3 pc__h3--r">The part most people would have skipped</h3>
        <p class="pc__prose">{p.restraint.text}</p>
        <div class="pc__rrec">
          {p.restraint.receipts.map((r) => (
            <a class="pc__rlink mono" href={r.href} target="_blank" rel="noopener noreferrer">
              {r.label} — {r.proves}
            </a>
          ))}
        </div>
      </section>
    )}

    {p.limits && p.limits.length > 0 && (
      <section class="pc__block reveal">
        <h3 class="pc__h3">What it can't do</h3>
        <ul class="pc__limits">
          {p.limits.map((l) => <li>{l}</li>)}
        </ul>
      </section>
    )}

    <div class="pc__stack reveal">
      <span class="label">Built with</span>
      <ul class="pc__chips">{p.stack.map((s) => <li class="mono">{s}</li>)}</ul>
    </div>

    <slot />
  </div>
</article>

<style>
  .pc { position: relative; }
  .pc[data-accent='ember'] { --pc: var(--ember); --pc-lit: var(--ember-lit); }
  .pc[data-accent='gold'],
  .pc[data-accent='verify'] { --pc: var(--gold); --pc-lit: var(--gold-lit); }

  .pc__i { color: var(--pc); }
  .pc__name { font-size: clamp(2.6rem, 7vw, 5.2rem); margin-top: var(--s-4); }
  .pc__native { font-size: 0.42em; color: var(--pc); margin-left: 0.35em; vertical-align: 0.3em; }
  .pc__tag {
    margin-top: var(--s-3);
    font-family: var(--display); font-style: italic;
    font-size: var(--t-sub); color: var(--pc);
  }
  .pc__hook { margin-top: var(--s-6); font-size: var(--t-sub); line-height: 1.5; color: var(--star); max-width: 52ch; }

  .pc__meta { margin-top: var(--s-8); display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4); }
  .pc__year { color: var(--dust); font-size: var(--t-micro); }
  .pc__btn {
    display: inline-flex; align-items: center; gap: var(--s-2);
    padding: var(--s-3) var(--s-6);
    border: var(--hair) solid var(--ridge); border-radius: var(--r-full);
    font-size: var(--t-small); text-decoration: none; color: var(--star-dim);
    transition: border-color var(--d-base) var(--ease), color var(--d-base) var(--ease), background var(--d-base) var(--ease);
  }
  .pc__btn:hover { border-color: var(--pc); color: var(--pc); }
  .pc__btn--live { border-color: var(--pc); color: var(--pc); background: color-mix(in oklab, var(--gold) 8%, transparent); }
  .pc__btn--muted { color: var(--dust); cursor: default; }
  .pc__btn--muted:hover { border-color: var(--ridge); color: var(--dust); }
  .pc__btn--live:hover { background: color-mix(in oklab, var(--gold) 16%, transparent); }

  .pc__hero { margin: var(--s-12) 0 0; }
  .pc__heroframe, .pc__shotframe {
    border-radius: var(--r-lg); overflow: hidden;
    outline: var(--hair) solid var(--ridge); outline-offset: -1px;
    box-shadow: var(--lift-2);
    background: var(--deep);
    /* Height budget, width derived — so a portrait capture gets narrow rather
       than three screens tall. Nothing is cropped at any point. */
    max-width: min(100%, calc(var(--hcap) * var(--ar)));
  }
  .pc__heroframe { --hcap: 620px; }
  .pc__shotframe { --hcap: 560px; }
  .pc__heroframe :global(img), .pc__shotframe :global(img) { width: 100%; height: auto; display: block; }

  /* A long capture of a scrolling page: a window you scroll inside, at full
     resolution, instead of a three-thousand-pixel strip nobody can read. */
  .pc__fig--long .pc__heroframe,
  .pc__fig--long .pc__shotframe {
    max-width: min(100%, 880px);
    height: 600px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--ridge) transparent;
  }
  .pc__fig--long .pc__shotframe { max-width: min(100%, 760px); height: 540px; }
  .pc__fig--long .pc__heroframe:focus-visible,
  .pc__fig--long .pc__shotframe:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }

  .pc__cap { margin-top: var(--s-4); font-size: var(--t-small); color: var(--dust); max-width: 62ch; line-height: 1.55; }
  .pc__scrollhint { color: var(--dust-faint); font-size: var(--t-micro); }

  /* Each block is a spread: the heading sits in a rail on the left and stays
     with you while its section scrolls past, and the content runs at a proper
     reading measure beside it. Before this the prose was a narrow column on the
     left of a 1,296px page with nine hundred pixels of nothing to the right of
     it — correct typographically, and it looked like a draft. */
  .pc__block { margin-top: clamp(var(--s-12), 6vh, var(--s-20)); }

  @media (min-width: 1080px) {
    .pc__block {
      display: grid;
      grid-template-columns: 15rem minmax(0, 72ch);
      gap: clamp(var(--s-8), 4vw, var(--s-16));
      align-items: start;
    }
    .pc__block > .pc__h3 {
      grid-column: 1;
      position: sticky;
      top: var(--s-12);
      margin: 0;
      text-align: right;
      text-wrap: balance;
    }
    .pc__block > :not(.pc__h3) { grid-column: 2; }
    /* The quoted block keeps its rule on the left, so it cannot join the grid. */
    .pc__restraint { display: block; }
    .pc__restraint > .pc__h3 { position: static; text-align: left; }
  }

  /* The story runs a size larger than body copy — it is the part that has to be
     read, so it should look like the part that has to be read. */
  .pc__story { max-width: 70ch; }
  @media (min-width: 1080px) { .pc__story { display: block; margin-left: calc(15rem + clamp(var(--s-8), 4vw, var(--s-16))); } }
  .pc__storyp {
    font-size: clamp(1.05rem, 1.35vw, 1.22rem);
    line-height: 1.62;
    color: var(--star-dim);
  }
  .pc__storyp + .pc__storyp { margin-top: var(--s-6); }
  .pc__storyp :global(em) { color: var(--gold); font-style: italic; font-family: var(--display); }
  .pc__story .pc__storyp:first-child::first-letter {
    font-family: var(--display);
    font-variation-settings: 'opsz' 72;
    font-size: 3.1em; line-height: 0.82;
    float: left; margin: 0.06em 0.09em 0 0;
    color: var(--gold);
  }
  .pc__h3 {
    font-family: var(--display); font-variation-settings: 'opsz' 28;
    font-size: var(--t-head); font-weight: 500; color: var(--star);
  }
  .pc__h3--r { color: var(--pc); }
  .pc__sub { margin-top: var(--s-2); font-size: var(--t-small); color: var(--dust); }
  .pc__prose { margin-top: var(--s-6); max-width: var(--measure); color: var(--star-dim); }
  .pc__mech { list-style: none; padding: 0; margin: var(--s-8) 0 0; }

  .pc__shots { margin-top: var(--s-12); display: flex; flex-direction: column; gap: clamp(var(--s-8), 5vh, var(--s-16)); }
  .pc__shot { margin: 0; max-width: 880px; }
  .pc__shot:nth-child(even) { margin-left: auto; }

  .pc__figs {
    margin-top: var(--s-8);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 0 var(--s-12);
  }

  .pc__restraint {
    border-left: 2px solid var(--pc);
    padding-left: var(--s-8);
  }
  .pc__rrec { margin-top: var(--s-6); display: flex; flex-direction: column; gap: var(--s-2); }
  .pc__rlink { font-size: var(--t-micro); color: var(--pc); text-decoration: none; }
  .pc__rlink:hover { text-decoration: underline; text-underline-offset: 3px; }

  .pc__limits { margin: var(--s-6) 0 0; padding-left: var(--s-6); max-width: var(--measure); color: var(--dust); }
  .pc__limits li { margin-bottom: var(--s-3); }
  .pc__limits li::marker { color: var(--dust-faint); }

  .pc__stack { margin-top: var(--s-16); }
  .pc__chips { list-style: none; padding: 0; margin: var(--s-4) 0 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .pc__chips li {
    font-size: var(--t-micro); color: var(--dust);
    padding: 3px var(--s-3);
    border: var(--hair) solid var(--ridge); border-radius: var(--r-sm);
  }

  @media (max-width: 640px) {
    .pc__restraint { padding-left: var(--s-4); }
    .pc__shot:nth-child(even) { margin-left: 0; }
  }
</style>
