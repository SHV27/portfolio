---
/**
 * A full project case study.
 *
 * Structure is fixed on purpose, so a reader learns it once and can then skim
 * seven of them: what it is → why it is hard → how it actually works (receipted)
 * → the numbers (receipted) → what he refused to do → the honest limits.
 *
 * The "restraint" and "limits" blocks are the ones that matter most. Anyone can
 * list features; almost nobody publishes what their system cannot do.
 */
import { Image } from 'astro:assets';
import Claim from '../components/Claim.astro';
import Figure from '../components/Figure.astro';
import type { Project } from '../content/types';
import { repoUrl } from '../content/types';

interface Props { project: Project; index: string; shots: Record<string, any>; }
const { project: p, index, shots } = Astro.props;
---

<article class="pc section" id={p.id} data-accent={p.accent ?? 'gold'}>
  <div class="wrap">

    <header class="pc__head reveal">
      <p class="label pc__i">{index}</p>
      <h2 class="pc__name display">
        {p.name}{p.native && <span class="pc__native deva">{p.native}</span>}
      </h2>
      {p.tagline && <p class="pc__tag">{p.tagline}</p>}
      <p class="pc__hook">{p.hook}</p>

      <div class="pc__meta">
        <span class="mono pc__year">{p.year}</span>
        <a class="pc__btn" href={repoUrl(p.repo)} target="_blank" rel="noopener noreferrer">
          Read the code
          <svg width="11" height="11" viewBox="0 0 11 11" aria-hidden="true"><path d="M2.5 8.5 L8.5 2.5 M4 2.5 h4.5 v4.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square"/></svg>
        </a>
        {p.live && (
          <a class="pc__btn pc__btn--live" href={p.live} target="_blank" rel="noopener noreferrer">
            Open it — it's running
            <svg width="11" height="11" viewBox="0 0 11 11" aria-hidden="true"><path d="M2.5 8.5 L8.5 2.5 M4 2.5 h4.5 v4.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square"/></svg>
          </a>
        )}
      </div>
    </header>

    {p.shots[0] && shots[p.shots[0].file] && (
      <figure class="pc__hero reveal">
        <div class="pc__heroframe">
          <Image src={shots[p.shots[0].file]} alt={p.shots[0].alt} widths={[640, 980, 1320]} sizes="(max-width:900px) 92vw, 1100px" loading="lazy" decoding="async" format="avif" />
        </div>
        <figcaption class="pc__cap">{p.shots[0].caption}</figcaption>
      </figure>
    )}

    <section class="pc__block reveal">
      <h3 class="pc__h3">Why it's hard</h3>
      <p class="pc__prose">{p.hardProblem}</p>
    </section>

    <section class="pc__block reveal">
      <h3 class="pc__h3">How it actually works</h3>
      <p class="pc__sub">Every line below opens to the code that proves it.</p>
      <ul class="pc__mech">
        {p.mechanism.map((c) => <Claim claim={c} />)}
      </ul>
    </section>

    {p.shots.length > 1 && (
      <div class="pc__shots">
        {p.shots.slice(1).map((s) => shots[s.file] && (
          <figure class="pc__shot reveal">
            <div class="pc__shotframe">
              <Image src={shots[s.file]} alt={s.alt} widths={[520, 820]} sizes="(max-width:900px) 92vw, 760px" loading="lazy" decoding="async" format="avif" />
            </div>
            <figcaption class="pc__cap">{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    )}

    <section class="pc__block reveal">
      <h3 class="pc__h3">The numbers</h3>
      <div class="pc__figs">
        {p.figures.map((f) => <Figure figure={f} />)}
      </div>
    </section>

    {p.restraint && (
      <section class="pc__block pc__restraint reveal">
        <h3 class="pc__h3 pc__h3--r">The part most people would have skipped</h3>
        <p class="pc__prose">{p.restraint.text}</p>
        <div class="pc__rrec">
          {p.restraint.receipts.map((r) => (
            <a class="pc__rlink mono" href={r.href} target="_blank" rel="noopener noreferrer">
              {r.label} — {r.proves}
            </a>
          ))}
        </div>
      </section>
    )}

    {p.limits && p.limits.length > 0 && (
      <section class="pc__block reveal">
        <h3 class="pc__h3">What it can't do</h3>
        <p class="pc__sub">Taken from the repository's own documentation, not softened.</p>
        <ul class="pc__limits">
          {p.limits.map((l) => <li>{l}</li>)}
        </ul>
      </section>
    )}

    <div class="pc__stack reveal">
      <span class="label">Built with</span>
      <ul class="pc__chips">{p.stack.map((s) => <li class="mono">{s}</li>)}</ul>
    </div>

    <slot />
  </div>
</article>

<style>
  .pc { position: relative; }
  .pc[data-accent='ember'] { --pc: var(--ember); --pc-lit: var(--ember-lit); }
  .pc[data-accent='gold'],
  .pc[data-accent='verify'] { --pc: var(--gold); --pc-lit: var(--gold-lit); }

  .pc__i { color: var(--pc); }
  .pc__name { font-size: clamp(2.6rem, 7vw, 5.2rem); margin-top: var(--s-4); }
  .pc__native { font-size: 0.42em; color: var(--pc); margin-left: 0.35em; vertical-align: 0.3em; }
  .pc__tag {
    margin-top: var(--s-3);
    font-family: var(--display); font-style: italic;
    font-size: var(--t-sub); color: var(--pc);
  }
  .pc__hook { margin-top: var(--s-6); font-size: var(--t-sub); line-height: 1.5; color: var(--star); max-width: 52ch; }

  .pc__meta { margin-top: var(--s-8); display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4); }
  .pc__year { color: var(--dust); font-size: var(--t-micro); }
  .pc__btn {
    display: inline-flex; align-items: center; gap: var(--s-2);
    padding: var(--s-3) var(--s-6);
    border: var(--hair) solid var(--ridge); border-radius: var(--r-full);
    font-size: var(--t-small); text-decoration: none; color: var(--star-dim);
    transition: border-color var(--d-base) var(--ease), color var(--d-base) var(--ease), background var(--d-base) var(--ease);
  }
  .pc__btn:hover { border-color: var(--pc); color: var(--pc); }
  .pc__btn--live { border-color: var(--pc); color: var(--pc); background: color-mix(in oklab, var(--gold) 8%, transparent); }
  .pc__btn--live:hover { background: color-mix(in oklab, var(--gold) 16%, transparent); }

  .pc__hero { margin: var(--s-16) 0 0; }
  .pc__heroframe, .pc__shotframe {
    border-radius: var(--r-lg); overflow: hidden;
    outline: var(--hair) solid var(--ridge); outline-offset: -1px;
    box-shadow: var(--lift-2);
    background: var(--deep);
  }
  .pc__heroframe :global(img), .pc__shotframe :global(img) { width: 100%; height: auto; }
  .pc__cap { margin-top: var(--s-4); font-size: var(--t-small); color: var(--dust); max-width: 62ch; line-height: 1.55; }

  .pc__block { margin-top: clamp(var(--s-16), 9vh, var(--s-24)); }
  .pc__h3 {
    font-family: var(--display); font-variation-settings: 'opsz' 28;
    font-size: var(--t-head); font-weight: 500; color: var(--star);
  }
  .pc__h3--r { color: var(--pc); }
  .pc__sub { margin-top: var(--s-2); font-size: var(--t-small); color: var(--dust); }
  .pc__prose { margin-top: var(--s-6); max-width: var(--measure); color: var(--star-dim); }
  .pc__mech { list-style: none; padding: 0; margin: var(--s-8) 0 0; }

  .pc__shots { margin-top: var(--s-16); display: flex; flex-direction: column; gap: clamp(var(--s-12), 7vh, var(--s-24)); }
  .pc__shot { margin: 0; max-width: 820px; }
  .pc__shot:nth-child(even) { margin-left: auto; }

  .pc__figs {
    margin-top: var(--s-8);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 0 var(--s-12);
  }

  .pc__restraint {
    border-left: 2px solid var(--pc);
    padding-left: var(--s-8);
  }
  .pc__rrec { margin-top: var(--s-6); display: flex; flex-direction: column; gap: var(--s-2); }
  .pc__rlink { font-size: var(--t-micro); color: var(--pc); text-decoration: none; }
  .pc__rlink:hover { text-decoration: underline; text-underline-offset: 3px; }

  .pc__limits { margin: var(--s-6) 0 0; padding-left: var(--s-6); max-width: var(--measure); color: var(--dust); }
  .pc__limits li { margin-bottom: var(--s-3); }
  .pc__limits li::marker { color: var(--dust-faint); }

  .pc__stack { margin-top: var(--s-16); }
  .pc__chips { list-style: none; padding: 0; margin: var(--s-4) 0 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .pc__chips li {
    font-size: var(--t-micro); color: var(--dust);
    padding: 3px var(--s-3);
    border: var(--hair) solid var(--ridge); border-radius: var(--r-sm);
  }

  @media (max-width: 640px) {
    .pc__restraint { padding-left: var(--s-4); }
    .pc__shot:nth-child(even) { margin-left: 0; }
  }
</style>
