---
/**
 * THE WORK INDEX.
 *
 * Seven rows, each one a link to its own page. Image and text sit side by side
 * and alternate sides down the page — not a card grid (the single most reliable
 * signature of generated layout) and not a vertical stack of full-width images,
 * which is what made the old page feel endless.
 *
 * A reviewer can now see all seven in about two screens and choose where to go,
 * instead of scrolling through eighty-four.
 */
import { Image } from 'astro:assets';
import { ORDER } from '../content/all';
import { SHOTS } from '../content/shots';
import analyticsShot from '../assets/shots/astro/frbprint.png';

// The analytics chapter is not a repo-backed Project, so it is inserted by hand
// at the position the brief gives it — fifth, right after Braillix.
//
// The numbers shown here are the SAME numbers each project page prints at its
// top. They used to be derived from array position, which drifted the moment
// Data & Signal was inserted, so /projects/reckoner said "Project 05" while the
// index called the same thing 06. One source now.
const NO: Record<string, string> = {
  sifarish: '01', aaina: '02', jarvis: '03', braillix: '04', 'data-signal': '05',
  reckoner: '06', uruthi: '07', 'sehat-saarthi': '08', gloaming: '09',
};
const ROWS = [
  ...ORDER.slice(0, 4).map((p) => ({
    id: p.id, href: `/projects/${p.id}`, name: p.name, native: p.native,
    hook: p.hook, year: p.year, live: p.live,
    img: SHOTS[p.shots[0]?.file], alt: p.shots[0]?.alt ?? p.name,
    tag: null as string | null,
  })),
  {
    id: 'data-signal',
    href: '/projects/data-signal', name: 'Data & Signal', native: undefined,
    hook: 'Label-efficient transfer learning on 17,736 real survey images, and three detection pipelines validated by planting a signal and measuring how much came back.',
    year: 'Apr – May 2026', live: undefined,
    img: analyticsShot, alt: 'Three analysis panels on a dark background showing a dispersion-measure residual plot, a class-separation histogram, and a sky map.',
    tag: 'Analytics',
  },
  ...ORDER.slice(4).map((p) => ({
    id: p.id, href: `/projects/${p.id}`, name: p.name, native: p.native,
    hook: p.hook, year: p.year, live: p.live,
    img: SHOTS[p.shots[0]?.file], alt: p.shots[0]?.alt ?? p.name,
    tag: null as string | null,
  })),
];
---

<section class="wk section" id="work">
  <div class="wrap">
    <p class="label wk__k">The work</p>
    <h2 class="wk__t display">Nine things nobody asked me to build.</h2>
    <p class="wk__lede lede">
      Seven of them are running right now at URLs you can open. Click any project for the whole story.
    </p>

    <div class="wk__pick">
      <p class="wk__pickk label">Whoever you are, one of these is for you</p>
      <ul class="wk__picks">
        <li><span class="wk__who">Building AI products</span><span class="wk__arrow">→</span><a href="/projects/sifarish">Sifarish</a> <span class="wk__and">and</span> <a href="/projects/aaina">Aaina</a></li>
        <li><span class="wk__who">Agents, voice or on-device AI</span><span class="wk__arrow">→</span><a href="/projects/jarvis">JARVIS</a></li>
        <li><span class="wk__who">Care about social impact</span><span class="wk__arrow">→</span><a href="/projects/braillix">Braillix</a> <span class="wk__and">and</span> <a href="/projects/sehat-saarthi">Sehat Saarthi</a></li>
        <li><span class="wk__who">Hiring for data or analytics</span><span class="wk__arrow">→</span><a href="/projects/reckoner">Reckoner</a> <span class="wk__and">and</span> <a href="/projects/data-signal">Data &amp; Signal</a></li>
        <li><span class="wk__who">A B2B or enterprise team</span><span class="wk__arrow">→</span><a href="/projects/uruthi">Uruthi</a></li>
        <li><span class="wk__who">Games, or anything with craft in it</span><span class="wk__arrow">→</span><a href="/projects/gloaming">Gloaming</a></li>
      </ul>
      <p class="wk__pickn">
        Sifarish and Aaina are the two I would lead with anywhere. The rest exist because the domain kept
        changing and the method did not.
      </p>
    </div>

    <ol class="wk__list">
      {ROWS.map((r, i) => (
        <li class="wk__row reveal">
          <a class:list={['wk__link', !r.img && 'wk__link--noimg']} href={r.href}>
            {r.img && (
              <div class="wk__media">
                <Image src={r.img} alt={r.alt} widths={[420, 680]} sizes="(max-width: 860px) 92vw, 460px" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" format="avif" />
              </div>
            )}
            <div class="wk__body">
              <p class="wk__i mono">{NO[r.id] ?? String(i + 1).padStart(2, '0')}{r.tag && <span class="wk__tag">{r.tag}</span>}</p>
              <h3 class="wk__name display display--mid">
                {r.name}{r.native && <span class="wk__native deva">{r.native}</span>}
              </h3>
              <p class="wk__hook">{r.hook}</p>
              <p class="wk__meta">
                <span class="mono wk__year">{r.year}</span>
                {r.live && <span class="wk__live mono">live</span>}
              </p>
              <span class="wk__go">
                Read it
                <svg width="13" height="13" viewBox="0 0 13 13" aria-hidden="true"><path d="M3 10 L10 3 M5 3 h5 v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"/></svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .wk__k { color: var(--gold); }
  .wk__t { font-size: var(--t-title); margin-top: var(--s-4); max-width: 18ch; }
  .wk__lede { margin-top: var(--s-6); }

  .wk__pick {
    margin-top: var(--s-10);
    padding: var(--s-8);
    border: var(--hair) solid var(--ridge);
    border-radius: var(--r-lg);
    background: color-mix(in oklab, var(--deep) 55%, transparent);
    max-width: 66ch;
  }
  .wk__pickk { color: var(--gold); }
  .wk__picks { list-style: none; padding: 0; margin: var(--s-6) 0 0; display: flex; flex-direction: column; gap: var(--s-4); }
  .wk__picks li { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-3); font-size: var(--t-small); }
  .wk__who { color: var(--dust); min-width: 20ch; }
  .wk__arrow { color: var(--gold-deep); }
  .wk__and { color: var(--dust-faint); font-size: var(--t-micro); }
  .wk__picks a {
    color: var(--star); text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--gold) 40%, transparent);
    transition: color var(--d-fast) var(--ease);
  }
  .wk__picks a:hover { color: var(--gold); }
  .wk__pickn { margin-top: var(--s-6); font-size: var(--t-micro); color: var(--dust); line-height: 1.6; }

  .wk__list { list-style: none; padding: 0; margin: var(--s-16) 0 0; }
  .wk__row + .wk__row { margin-top: var(--s-4); }

  .wk__link {
    display: grid;
    grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
    gap: clamp(var(--s-6), 4vw, var(--s-12));
    align-items: center;
    padding: var(--s-8) 0;
    border-top: var(--hair) solid var(--ridge);
    text-decoration: none;
    transition: border-color var(--d-base) var(--ease);
  }
  .wk__row:last-child .wk__link { border-bottom: var(--hair) solid var(--ridge); }
  /* A row with no screenshot gets the whole width rather than a blank frame.
     JARVIS is a private Windows assistant — there is nothing public to show,
     and an empty box reads as a broken image, not as restraint. */
  .wk__link--noimg { grid-template-columns: minmax(0, 1fr); }
  .wk__link--noimg .wk__hook { max-width: 68ch; }
  .wk__link:hover { border-color: var(--gold-deep); }

  /* Alternate the side the image sits on — a straight column of images down the
     left is exactly the stacked rhythm this replaced. */
  .wk__row:nth-child(even) .wk__link { grid-template-columns: minmax(0, 1fr) minmax(0, 460px); }
  .wk__row:nth-child(even) .wk__media { order: 2; }

  .wk__media {
    border-radius: var(--r-md); overflow: hidden;
    outline: var(--hair) solid var(--ridge); outline-offset: -1px;
    background: var(--deep);
    aspect-ratio: 16 / 10;
    box-shadow: var(--lift-1);
  }
  .wk__media :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: top center;
    transition: transform var(--d-slow) var(--ease-out), filter var(--d-slow) var(--ease);
    filter: saturate(0.9);
  }
  .wk__link:hover .wk__media :global(img) { transform: scale(1.03); filter: saturate(1.05); }

  .wk__i { font-size: var(--t-micro); color: var(--gold-deep); display: flex; gap: var(--s-3); align-items: center; }
  .wk__tag {
    color: var(--verify); border: var(--hair) solid currentColor;
    border-radius: var(--r-sm); padding: 1px 6px; font-size: 0.6875rem;
  }
  .wk__name { font-size: clamp(1.9rem, 4vw, 3rem); margin-top: var(--s-3); color: var(--star); }
  .wk__native { font-size: 0.45em; color: var(--gold); margin-left: 0.35em; vertical-align: 0.3em; }
  .wk__hook { margin-top: var(--s-4); color: var(--star-dim); max-width: 52ch; font-size: var(--t-small); line-height: 1.6; }
  .wk__meta { margin-top: var(--s-5); display: flex; gap: var(--s-4); align-items: center; }
  .wk__year { font-size: var(--t-micro); color: var(--dust); }
  .wk__live {
    font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--verify); display: inline-flex; align-items: center; gap: 5px;
  }
  .wk__live::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }

  .wk__go {
    margin-top: var(--s-6);
    display: inline-flex; align-items: center; gap: var(--s-2);
    font-size: var(--t-small); color: var(--gold);
  }
  .wk__go svg { transition: transform var(--d-base) var(--ease); }
  .wk__link:hover .wk__go svg { transform: translate(2px, -2px); }

  @media (max-width: 860px) {
    .wk__link,
    .wk__row:nth-child(even) .wk__link { grid-template-columns: 1fr; gap: var(--s-6); }
    .wk__row:nth-child(even) .wk__media { order: 0; }
    .wk__name { font-size: clamp(1.6rem, 7vw, 2.2rem); }
  }
</style>
