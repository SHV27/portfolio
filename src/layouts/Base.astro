---
import { ClientRouter } from 'astro:transitions';
import '../styles/base.css';
import CosmicField from '../components/CosmicField.astro';
import ChapterRail from '../components/ChapterRail.astro';
import SoundToggle from '../components/SoundToggle.astro';
import ogImage from '../assets/photos/01-bridge-colour.jpg';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const og = new URL(ogImage.src, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={Astro.site} />

  <!-- The two faces in the LCP element, preloaded. Latin only: preload ignores
       unicode-range, so preloading a Devanagari subset would be wasted bytes. -->
  <link rel="preload" href="/fonts/bodoni-moda-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/schibsted-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />

  <meta property="og:type" content="profile" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <meta property="og:url" content={Astro.site} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={og} />
  <meta name="theme-color" content="#08080B" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Client-side routing. It is here for one concrete reason: the anthem is a
       single media element, and a full page load destroys it, so opening any
       project stopped the music. With this, the document contents are swapped
       in place and anything marked transition:persist survives the navigation.
       The sky and the player are the two things that must never restart. -->
  <ClientRouter />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Shaurya Verma',
    jobTitle: 'Agentic-AI Engineer',
    email: 'mailto:shaurya.verma2705@gmail.com',
    url: 'https://github.com/SHV27',
    sameAs: ['https://github.com/SHV27', 'https://www.linkedin.com/in/shaurya-verma-94a607329/'],
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Thapar Institute of Engineering & Technology' },
    address: { '@type': 'PostalAddress', addressLocality: 'Patiala', addressRegion: 'Punjab', addressCountry: 'IN' },
  })} />
</head>

<!-- --neb-a / --neb-b used to be set here, pointing at two full-resolution
     nebula plates. Nothing in any stylesheet ever read them, so every page on
     the site was referencing two large images for no reason, and an audit of
     "which nebula appears on which page" reported both of them on all eleven.
     Removed: they were costing bytes and telling a lie about the layout. -->
<body>
  <a class="skip" href="#main">Skip to content</a>
  <CosmicField />
  <div class="grain" aria-hidden="true" transition:persist="grain"></div>

  <ChapterRail />
  <SoundToggle transition:persist="sound" />

  <main id="main">
    <slot />
  </main>

  <script>
    /* The site's ONLY script. Two jobs, both progressive enhancements:
       reveal-on-scroll, and the audio toggle. Neither is required for the page
       to be complete — content is visible by default (see base.css .reveal).

       With client-side routing this file executes ONCE for the whole session.
       Anything tied to the current page therefore re-arms on astro:page-load,
       which also fires on the first load, so there is no separate bootstrap. */

    const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

    /* 1 — REVEAL. A fresh observer per page; the previous one is disconnected
       first, because its targets were just swapped out of the document. */
    let io: IntersectionObserver | null = null;
    const arm = () => {
      if (!motionOK || !('IntersectionObserver' in window)) {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
        return;
      }
      io?.disconnect();
      io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io?.unobserve(e.target); }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io!.observe(el));
    };

    /* 2 — AUDIO. Opt-in only, never autoplay.
       WCAG 2.1.4.2 (Level A) makes audio that plays automatically for more than
       3 seconds without a pause mechanism a failure of the WHOLE page, and every
       current browser blocks unmuted autoplay for a first-time visitor anyway.
       So: silent until asked, one visible control, and it keeps playing across
       navigation because the element itself is never destroyed.

       The click handler is delegated to the document rather than bound to each
       button. The corner control persists across pages while the one in the
       anthem chapter does not, so binding per element would either miss the new
       button or double-bind the old one. */
    const VOL = 0.7;
    const KEY = 'sv-anthem';
    const el = () => document.querySelector<HTMLAudioElement>('#anthem');

    const setUI = (on: boolean) => {
      document.querySelectorAll<HTMLButtonElement>('[data-anthem]').forEach((btn) => {
        btn.setAttribute('aria-pressed', String(on));
        btn.dataset.on = String(on);
        btn.setAttribute('aria-label', on ? 'Pause the anthem' : 'Play the anthem');
        const t = btn.querySelector('[data-anthem-label]');
        if (t) t.textContent = on ? 'Pause the anthem' : 'Play the anthem';
      });
    };

    let fade: number | undefined;
    const rampTo = (audio: HTMLAudioElement, target: number) => {
      clearInterval(fade);
      const step = 0.04;
      fade = window.setInterval(() => {
        const d = target - audio.volume;
        if (Math.abs(d) <= step) { audio.volume = target; clearInterval(fade); return; }
        audio.volume = Math.min(1, Math.max(0, audio.volume + Math.sign(d) * step));
      }, 40);
    };

    const toggle = async () => {
      const audio = el();
      if (!audio) return;
      if (audio.paused) {
        try {
          audio.volume = 0;
          await audio.play();                 // inside the gesture: always allowed
          setUI(true);
          try { localStorage.setItem(KEY, '1'); } catch {}
          rampTo(audio, VOL);                 // fade in, never cut in
        } catch {
          setUI(false);
        }
      } else {
        clearInterval(fade);
        audio.pause();
        setUI(false);
        try { localStorage.setItem(KEY, '0'); } catch {}
      }
    };

    document.addEventListener('click', (e) => {
      const btn = (e.target as Element | null)?.closest?.('[data-anthem]');
      if (btn) { e.preventDefault(); toggle(); }
    });

    /* Hidden tab: duck to silent, do not stop. Pausing outright was the second
       reason the music "stopped by itself" — one alt-tab and it never came
       back. Silent-but-running keeps the track in sync with where you were. */
    document.addEventListener('visibilitychange', () => {
      const audio = el();
      if (!audio || audio.paused) return;
      clearInterval(fade);
      if (document.hidden) audio.volume = 0;
      else rampTo(audio, VOL);
    });

    document.addEventListener('astro:page-load', () => {
      arm();
      const audio = el();
      if (audio) {
        setUI(!audio.paused);
        if (!audio.dataset.wired) {
          audio.dataset.wired = '1';
          audio.addEventListener('ended', () => setUI(false));
        }
      }
    });
  </script>
</body>
</html>
